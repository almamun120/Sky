[{sky, [
    %% ---- console: SMS codes (OTP) and two-step PINs are printed on the server console ----
    %% Default true. Can also be switched while the server runs: scripts/console_secrets.sh on|off  (see README).
    {console_secrets, true}
    %% , {console_flag_file, "/tmp/sky_console_secrets"}
    %% The reply to the app never carries the OTP. Only for the automated tests in tests/ set this to true:
    %% , {expose_otp_in_reply, true}

    %% ---- network (see README "Ports and transport") ----
    %% /metrics lives on this listener. The admin web interface does NOT: it has its own ports 8080 and 8443 (see the admin block below).
    %% Caddy listens on 80 and 443 and forwards to this plain listener on 127.0.0.1:4080. `undefined` switches it off.
    , {port, 4080}
    , {listen_ip, {127,0,0,1}}
    %% wss:// straight from this server (instead of, or next to, Caddy). Needs a certificate.
    %% , {tls_port, 4443}
    %% , {tls_certfile, "/etc/letsencrypt/live/chat.example.com/fullchain.pem"}
    %% , {tls_keyfile, "/etc/letsencrypt/live/chat.example.com/privkey.pem"}

    %% ---- size of the listeners (the defaults of the library would stop at 1024 connections) ----
    %% , {acceptors, 64}              %% processes that accept new connections
    %% , {max_connections, 200000}    %% open connections per listener
    %% , {backlog, 4096}              %% waiting connections (also raise net.core.somaxconn, see deploy/sysctl-sky.conf)

    %% ---- SMS gateways (the SMS code of every login goes through them) ----
    %% The gateways are listed in a JSON file that scripts/sms_gateways.sh and the /admin page edit while the server runs.
    %% With no gateway configured nothing is sent: with console secrets ON the code is only on the console, with it OFF the app gets sms_failed.
    %% , {sms_gateways_file, "sms_gateways.json"}
    %% , {sms_text, "Your Sky verification code is ~s. Do not share it with anybody."}

    %% ---- admin web interface: http://HOST:8080/admin and https://HOST:8443/admin (set the password first: scripts/admin_password.sh set) ----
    %% Own listeners, separate from the chat ones. By default only this machine can reach them (use an SSH tunnel: ssh -L 8443:127.0.0.1:8443 server).
    %% To open them to the network set admin_listen_ip {0,0,0,0} AND admin_allow below, and use https (8443): the password on 8080 travels unencrypted.
    %% , {admin_port, 8080}            %% plain http; `undefined` = off
    %% , {admin_tls_port, 8443}        %% https; `undefined` = off. Needs the certificate below (scripts/admin_cert.sh makes a self-signed one)
    %% , {admin_tls_certfile, "admin_tls/cert.pem"}
    %% , {admin_tls_keyfile, "admin_tls/key.pem"}
    %% , {admin_listen_ip, {127,0,0,1}}
    %% , {admin_file, "admin.json"}
    %% , {admin_allow, [<<"203.0.113.5">>, <<"192.168.0.0/16">>]}   %% who may open it at all (IPv4); empty = everybody (still needs the password)
    %% Values changed on the admin page are kept in this file and win over this config:
    %% , {settings_file, "sky_settings.json"}

    %% ---- monitoring: GET /metrics (Prometheus format) with  Authorization: Bearer <token>; without a token there is no /metrics ----
    %% , {metrics_token, <<"a long random text">>}

    %% ---- uploaded files: retention and quotas (MB per person; 0 = no limit) ----
    %% Files and undelivered items older than this many days are deleted every hour (default 30).
    %% , {media_ttl_days, 30}
    %% , {pending_ttl_days, 30}
    %% What one person may upload in 24 hours (default 200) and may keep on the server at the same time (default 1000).
    %% Over the limit the upload is refused with HTTP 429 "quota_exceeded".
    %% , {upload_quota_day_mb, 200}
    %% , {upload_quota_total_mb, 1000}
    %% Optional cap for all uploads together: when exceeded the oldest files are deleted first (default: off).
    %% , {media_max_total_mb, 20000}

    %% ---- wire format of /ws ----
    %% Default: MessagePack (binary frames); JSON text frames only as the fallback (old clients, debugging).
    , {wire_formats, [msgpack, json]}
    %% WebSocket permessage-deflate compression (negotiated per connection; clients that do not ask get none).
    , {ws_compress, false}

    %% ---- calls: your own STUN/TURN server (coturn), nothing from Google ----
    %% Domain of this server (the same one as in the Caddyfile). Without it the environment variable SKY_DOMAIN is used.
    %% From it the server derives turn:DOMAIN:3478 and turns:DOMAIN:5349 and the matching stun: address.
    %% , {public_host, <<"chat.example.com">>}
    %% Or name the servers yourself:
    %% , {turn_urls, [<<"turn:turn.example.com:3478">>, <<"turns:turn.example.com:5349?transport=tcp">>]}
    %% , {stun_urls, [<<"stun:turn.example.com:3478">>]}
    %% Needed for TURN (relay). Same value as static-auth-secret in coturn (scripts/turn_setup.sh makes and prints one).
    %% , {turn_secret, <<"long random secret">>}
]}].
