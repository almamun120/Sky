[{sky, [
    {dev_mode, true}

    %% ---- network (see README "Step A: transport") ----
    %% Plain ws:// listener. `undefined` switches it off. Behind Caddy use {listen_ip, {127,0,0,1}}.
    , {port, 8080}
    %% , {listen_ip, {127,0,0,1}}
    %% wss:// straight from this server (instead of, or next to, Caddy). Needs a certificate.
    %% , {tls_port, 8443}
    %% , {tls_certfile, "/etc/letsencrypt/live/chat.example.com/fullchain.pem"}
    %% , {tls_keyfile, "/etc/letsencrypt/live/chat.example.com/privkey.pem"}

    %% ---- wire format of /ws ----
    %% Allowed formats in order of preference: msgpack = binary frames, json = text frames.
    %% Default: both, MessagePack first. [json] = JSON only (handy for debugging); [msgpack] = MessagePack only.
    %% A client that does not say what it wants (an old one) is served JSON, if json is in the list.
    , {wire_formats, [msgpack, json]}
    %% WebSocket permessage-deflate compression (negotiated per connection; clients that do not ask get none).
    , {ws_compress, false}

    %% Calls: run your own coturn (see turnserver.conf.example). It serves both STUN and TURN, so no
    %% third party is involved. STUN addresses are derived from turn_urls unless you set stun_urls.
    %% , {turn_urls, [<<"turn:turn.example.com:3478">>, <<"turns:turn.example.com:5349">>]}
    %% , {turn_secret, <<"same value as static-auth-secret in coturn">>}
    %% , {stun_urls, [<<"stun:turn.example.com:3478">>]}
]}].
