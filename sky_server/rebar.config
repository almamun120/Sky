{erl_opts, [debug_info]}.
{deps, [
    {cowboy, "2.10.0"},
    {gun, "2.0.1"},          %% WebSocket client for the SMS gateways
    {jsx, "3.1.0"}
]}.
{shell, [{config, "config/sys.config"}, {apps, [sky]}]}.

%% A real release (use this on the server):   rebar3 as prod release     ->   _build/prod/rel/sky/bin/sky foreground | start | stop | remote_console
{relx, [
    {release, {sky, "0.2.0"}, [sky, sasl]},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {extended_start_script, true}
]}.
{profiles, [{prod, [{relx, [{mode, prod}, {include_erts, true}]}]}]}.
