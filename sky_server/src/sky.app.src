{application, sky,
 [{description, "Sky messenger server"},
  {vsn, "0.2.0"},
  {registered, []},
  {mod, {sky_app, []}},
  {applications, [kernel, stdlib, crypto, ssl, public_key, cowboy, gun, jsx]},
  {env, [{port, 4080},
         %% console_secrets=true prints OTPs and PINs on the server console (default; switch: scripts/console_secrets.sh).
         %% Implement sky_sms:send/2 to send real SMS.
         {console_secrets, true}]}
 ]}.
